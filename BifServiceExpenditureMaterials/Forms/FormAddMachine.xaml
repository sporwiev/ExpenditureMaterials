<ui:FluentWindow x:Class="BifServiceExpenditureMaterials.Forms.FormAddMachine"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BifServiceExpenditureMaterials.Forms"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Добавить машину" Width="500" Height="250"
        Loaded="Window_Loaded"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок окна в стиле Fluent UI -->
        <ui:TitleBar Grid.Row="0" Title="Добавить машину"
                     ShowMinimize="False" ShowMaximize="False"/>

        <!-- Форма добавления -->
        <GroupBox Grid.Row="1" Header="Добавить машину" Margin="10,6,10,6"
                  BorderThickness="1" BorderBrush="#BDBDBD">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Название машины" Grid.Row="0"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                <ui:TextBox Grid.Row="0" Grid.Column="1"
                            PlaceholderText="РА12345178" x:Name="MachineTextBox"/>

                <TextBlock Text="Год" Grid.Row="1"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                <ComboBox Grid.Row="1" Grid.Column="1"
                          SelectedIndex="0" x:Name="YearComboBox"/>
            </Grid>
        </GroupBox>

        <!-- Кнопки действий -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10,0,10,10">
            <Button Width="150" Margin="0,0,10,0" Click="Button_Click"
                    Background="#2E7D32" Foreground="White"
                    FontWeight="SemiBold" Content="Добавить"/>
            <Button Width="150" Click="Button_Click_1" Content="Закрыть"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
