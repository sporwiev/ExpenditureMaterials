<UserControl x:Class="BifServiceExpenditureMaterials.Views.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:BifServiceExpenditureMaterials.Views.Pages"
             xmlns:controls="clr-namespace:BifServiceExpenditureMaterials.Controls"
             xmlns:vm="clr-namespace:BifServiceExpenditureMaterials.ViewModels.Pages"
             d:DataContext="{d:DesignInstance local:HomePage, IsDesignTimeCreatable=True}"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             Background="Transparent"
             d:DesignHeight="600" d:DesignWidth="1000">

    <UserControl.Resources>

        <!-- Стиль кнопок месяцев: прозрачный фон, закруглённые углы, эффект наведения -->
        <Style TargetType="Button" x:Key="monthButtons">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="10,5" CornerRadius="6"
                                BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4CAF50"/>
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль вкладок (оставлен для совместимости) -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="0"
                                CornerRadius="0,8,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ContentSite"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              ContentSource="Header"
                                              Margin="0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF28A745"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF218838"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22007ACC"/>
                                <Setter Property="Foreground" Value="#FF007ACC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="DarkGray"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль ячеек DataGrid (Excel-подобный) -->
        <Style x:Key="ExcelCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,-3,0,-2"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="Foreground" Value="Black"/>
                    <Setter Property="BorderThickness" Value="0.5"/>
                </Trigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Column.DisplayIndex}" Value="0">
                    <Setter Property="Background" Value="Orange"/>
                    <Setter Property="Foreground" Value="Black"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль заголовков колонок DataGrid (Excel-подобный) -->
        <Style x:Key="ExcelHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#D9EAD3"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="Gray"/>
            <Setter Property="BorderThickness" Value="0.5"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- Стиль обёртки текста -->
        <Style x:Key="WrapTextBlockStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

    </UserControl.Resources>

    <Grid Background="Transparent" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель: уведомления + инструменты -->
        <StackPanel Orientation="Vertical">

            <!-- Уведомление (скрыто по умолчанию) -->
            <StackPanel Margin="0,0,0,6">
                <ui:InfoBar x:Name="infobar" Title="" Message="" Opacity="0"
                            IsClosable="False" IsOpen="True" Severity="Success"/>
            </StackPanel>

            <!-- Панель инструментов -->
            <Border Background="#F5F5F5" CornerRadius="8" Padding="4,2" Margin="0,0,0,6"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Кнопка выбора года -->
                    <ui:DropDownButton Grid.Column="0" Margin="3" Width="70" Height="36"
                                       ToolTip="Выбрать год">
                        <ui:DropDownButton.Icon>
                            <ui:SymbolIcon Symbol="Smartwatch24" FontSize="18"/>
                        </ui:DropDownButton.Icon>
                        <ui:DropDownButton.Flyout>
                            <ContextMenu>
                                <StackPanel Orientation="Horizontal" Margin="8,6">
                                    <TextBlock Text="Год" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="YearComboBox" Width="80" VerticalAlignment="Center"
                                              SelectionChanged="YearComboBox_SelectionChanged"/>
                                </StackPanel>
                            </ContextMenu>
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>

                    <!-- Кнопка добавления машины -->
                    <ui:DropDownButton Grid.Column="1" Margin="3" Width="70" Height="36"
                                       ToolTip="Добавить машину">
                        <ui:DropDownButton.Icon>
                            <ui:SymbolIcon Symbol="Add24" FontSize="18"/>
                        </ui:DropDownButton.Icon>
                        <ui:DropDownButton.Flyout>
                            <ContextMenu>
                                <MenuItem Header="Добавить машину" Click="AddMachineBtn_Click"/>
                            </ContextMenu>
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>

                    <!-- Кнопка изменения машины -->
                    <ui:DropDownButton Grid.Column="2" Margin="3" Width="70" Height="36"
                                       ToolTip="Изменить машину">
                        <ui:DropDownButton.Icon>
                            <ui:SymbolIcon Symbol="DualScreenUpdate24" FontSize="18"/>
                        </ui:DropDownButton.Icon>
                        <ui:DropDownButton.Flyout>
                            <ContextMenu>
                                <MenuItem Header="Изменить машину" Click="UpdateMachineBtn_Click"/>
                            </ContextMenu>
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>

                    <!-- Кнопка фильтра по материалу -->
                    <ui:DropDownButton Grid.Column="3" Margin="3" Width="70" Height="36"
                                       ToolTip="Фильтр по типу материала">
                        <ui:DropDownButton.Icon>
                            <ui:SymbolIcon Symbol="Filter24" FontSize="18"/>
                        </ui:DropDownButton.Icon>
                        <ui:DropDownButton.Flyout>
                            <ContextMenu>
                                <StackPanel Orientation="Vertical" Margin="8,6" MinWidth="320">
                                    <TextBlock Text="Фильтр по материалу" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <ComboBox x:Name="TypeProductComboBox" Width="110" Margin="0,0,6,0"
                                                  SelectionChanged="TypeProductComboBox_SelectionChanged">
                                            <ComboBoxItem>Масло</ComboBoxItem>
                                            <ComboBoxItem>Антифриз</ComboBoxItem>
                                            <ComboBoxItem>Смазка</ComboBoxItem>
                                            <ComboBoxItem>Фильтры</ComboBoxItem>
                                        </ComboBox>
                                        <ComboBox x:Name="ProductComboBox" Width="110" Margin="0,0,6,0"
                                                  SelectionChanged="ProductComboBox_SelectionChanged"/>
                                        <Button Content="Применить" Margin="0,0,4,0"
                                                Click="FilterSaveButton_Click"/>
                                        <Button Content="Обновить"
                                                Click="UpdateFillTable_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </ContextMenu>
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>

                    <!-- Поиск по машинам -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="8,0">
                        <ui:AutoSuggestBox x:Name="SearchTextBox"
                                           PlaceholderText="Поиск по машинам..."
                                           Width="220" Height="32"/>
                    </StackPanel>

                    <!-- Кнопка печати -->
                    <Button Grid.Column="5" Height="36" Padding="12,0" Margin="3"
                            Command="{Binding ViewModel.PrintButton_ClickCommand}"
                            ToolTip="Открыть форму печати">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Print24" FontSize="16" Margin="0,0,4,0"/>
                            <TextBlock Text="Печать" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </Grid>
            </Border>

        </StackPanel>

        <!-- Область таблицы: переключатель месяцев + таблица расхода -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Кнопки переключения месяца -->
            <StackPanel Orientation="Horizontal" x:Name="monthPanel" VerticalAlignment="Center">
                <Button Style="{DynamicResource monthButtons}" Background="BlueViolet"
                        MouseEnter="Button_MouseEnter" Click="Button_Click">Январь</Button>
                <Button Style="{DynamicResource monthButtons}"
                        MouseEnter="Button_MouseEnter" Click="Button_Click">Февраль</Button>
                <Button Style="{DynamicResource monthButtons}"
                        MouseEnter="Button_MouseEnter" Click="Button_Click">Март</Button>
                <Button Style="{DynamicResource monthButtons}"
                        MouseEnter="Button_MouseEnter" Click="Button_Click">Апрель</Button>
                <Button Style="{DynamicResource monthButtons}"
                        MouseEnter="Button_MouseEnter" Click="Button_Click">Май</Button>
                <Button Style="{DynamicResource monthButtons}"
                        MouseEnter="Button_MouseEnter" Click="Button_Click">Июнь</Button>
                <Button Style="{DynamicResource monthButtons}"
                        MouseEnter="Button_MouseEnter" Click="Button_Click">Июль</Button>
                <Button Style="{DynamicResource monthButtons}"
                        MouseEnter="Button_MouseEnter" Click="Button_Click">Август</Button>
                <Button Style="{DynamicResource monthButtons}"
                        MouseEnter="Button_MouseEnter" Click="Button_Click">Сентябрь</Button>
                <Button Style="{DynamicResource monthButtons}"
                        MouseEnter="Button_MouseEnter" Click="Button_Click">Октябрь</Button>
                <Button Style="{DynamicResource monthButtons}"
                        MouseEnter="Button_MouseEnter" Click="Button_Click">Ноябрь</Button>
                <Button Style="{DynamicResource monthButtons}"
                        MouseEnter="Button_MouseEnter" Click="Button_Click">Декабрь</Button>
            </StackPanel>

            <!-- Таблица расхода материалов — заполняет всё доступное пространство -->
            <controls:MonthlyTable Grid.Row="1" x:Name="montableGl"
                                   ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                   ScrollViewer.VerticalScrollBarVisibility="Visible"
                                   ScrollViewer.CanContentScroll="True"/>
        </Grid>

    </Grid>
</UserControl>
