<UserControl x:Class="BifServiceExpenditureMaterials.Views.Pages.AddPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <!-- Заголовок -->
            <TextBlock Text="Добавление расходника"
                       FontSize="22" FontWeight="SemiBold"
                       Margin="0,0,0,16"/>

            <!-- Карточка формы -->
            <ui:Card Padding="20">
                <Grid x:Name="grid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="36"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Тип расходника -->
                    <TextBlock Text="Тип расходника"
                               Grid.Row="0" Grid.Column="0"
                               VerticalAlignment="Center"
                               FontWeight="Medium"/>
                    <ComboBox x:Name="combo"
                              Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                              SelectedIndex="0">
                        <ComboBoxItem Content="🛢 Масло"/>
                        <ComboBoxItem Content="❄ Антифриз"/>
                        <ComboBoxItem Content="🔧 Смазка"/>
                        <ComboBoxItem Content="🔩 Фильтр"/>
                    </ComboBox>

                    <!-- Поле 1 -->
                    <TextBlock x:Name="suzh1"
                               Grid.Row="2" Grid.Column="0"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                    <ui:TextBox x:Name="suzhtextbox1"
                                Grid.Row="2" Grid.Column="1"
                                Panel.ZIndex="1"/>
                    <ComboBox  x:Name="suzhcombobox1"
                               Grid.Row="2" Grid.Column="1"
                               IsEnabled="False" Panel.ZIndex="0"/>
                    <ui:Button x:Name="but1"
                               Grid.Row="2" Grid.Column="2"
                               Icon="{ui:SymbolIcon ArrowSync24}"
                               Padding="4" Margin="4,0,0,0"
                               Click="Button_Click_1"
                               ToolTip="Переключить ввод / список"/>

                    <!-- Поле 2 -->
                    <TextBlock x:Name="suzh2"
                               Grid.Row="4" Grid.Column="0"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                    <ui:TextBox x:Name="suzhtextbox2"
                                Grid.Row="4" Grid.Column="1"
                                Panel.ZIndex="1"/>
                    <ComboBox  x:Name="suzhcombobox2"
                               Grid.Row="4" Grid.Column="1"
                               IsEnabled="False" Panel.ZIndex="0"/>
                    <ui:Button x:Name="but2"
                               Grid.Row="4" Grid.Column="2"
                               Icon="{ui:SymbolIcon ArrowSync24}"
                               Padding="4" Margin="4,0,0,0"
                               Click="Button_Click_1"
                               ToolTip="Переключить ввод / список"/>

                    <!-- Поле 3 -->
                    <TextBlock x:Name="suzh3"
                               Grid.Row="6" Grid.Column="0"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                    <ui:TextBox x:Name="suzhtextbox3"
                                Grid.Row="6" Grid.Column="1"
                                Panel.ZIndex="1"/>
                    <ComboBox  x:Name="suzhcombobox3"
                               Grid.Row="6" Grid.Column="1"
                               IsEnabled="False" Panel.ZIndex="0"/>
                    <ui:Button x:Name="but3"
                               Grid.Row="6" Grid.Column="2"
                               Icon="{ui:SymbolIcon ArrowSync24}"
                               Padding="4" Margin="4,0,0,0"
                               Click="Button_Click_1"
                               ToolTip="Переключить ввод / список"/>

                    <!-- Название фильтра (только для типа Фильтр) -->
                    <TextBlock Text="Название фильтра"
                               Grid.Row="8" Grid.Column="0"
                               VerticalAlignment="Center"/>
                    <ui:TextBox x:Name="filterTextBox"
                                Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2"
                                PlaceholderText="Например: Масляный фильтр SP-1234"
                                IsEnabled="False"/>

                    <!-- Кнопка -->
                    <ui:Button Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3"
                               Content="Добавить расходник"
                               Icon="{ui:SymbolIcon Add24}"
                               Appearance="Primary"
                               HorizontalAlignment="Left"
                               Click="Button_Click"/>
                </Grid>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>
</UserControl>
