<UserControl x:Class="BifServiceExpenditureMaterials.Views.Pages.UpdateApplicationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <!-- Заголовок -->
            <TextBlock Text="Обновление приложения"
                       FontSize="22" FontWeight="SemiBold"
                       Margin="0,0,0,16"/>

            <!-- Текущая версия -->
            <ui:Card Padding="16" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="CurrentVersion"
                                   Text="Загрузка версии..."
                                   FontSize="16" FontWeight="Medium"/>
                        <TextBlock x:Name="StatusText"
                                   Text=""
                                   FontSize="13"
                                   Foreground="Gray"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Кнопка для обычного пользователя -->
                        <ui:Button x:Name="ButtonInstallProject"
                                   Content="Установить актуальную версию"
                                   Icon="{ui:SymbolIcon ArrowDownload24}"
                                   Appearance="Primary"
                                   Margin="0,0,8,0"
                                   Visibility="Collapsed"
                                   Click="ButtonInstallProject_Click"/>
                        <!-- Кнопка для администратора (загрузка новой версии на сервер) -->
                        <ui:Button x:Name="ButtonInstall"
                                   Content="Загрузить на сервер"
                                   Icon="{ui:SymbolIcon ArrowUpload24}"
                                   Visibility="Collapsed"
                                   Click="ButtonInstall_Click"/>
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- Список версий -->
            <TextBlock Text="Доступные версии"
                       FontSize="15" FontWeight="Medium"
                       Margin="0,0,0,8"/>
            <ui:Card Padding="0">
                <ui:ListView x:Name="ListBoxVersionProject"
                             MinHeight="200"
                             BorderThickness="0"/>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>
</UserControl>
