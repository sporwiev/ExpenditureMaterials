<UserControl x:Class="BifServiceExpenditureMaterials.Views.Pages.BayMaterialsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <!-- Заголовок -->
            <TextBlock Text="Пополнение запасов"
                       FontSize="22" FontWeight="SemiBold"
                       Margin="0,0,0,16"/>

            <ui:Card Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Тип расходника -->
                    <TextBlock Text="Тип расходника"
                               Grid.Row="0" Grid.Column="0"
                               VerticalAlignment="Center" FontWeight="Medium"/>
                    <ComboBox x:Name="TypeProductComboBox"
                              Grid.Row="0" Grid.Column="1"
                              SelectionChanged="ComboBox_SelectionChanged">
                        <ComboBoxItem Content="🛢 Масло"/>
                        <ComboBoxItem Content="❄ Антифриз"/>
                        <ComboBoxItem Content="🔧 Смазка"/>
                        <ComboBoxItem Content="🔩 Фильтр"/>
                    </ComboBox>

                    <!-- Выбор продукта -->
                    <TextBlock Text="Наименование"
                               Grid.Row="2" Grid.Column="0"
                               VerticalAlignment="Center" FontWeight="Medium"/>
                    <ComboBox x:Name="ComboBoxProduct"
                              Grid.Row="2" Grid.Column="1"
                              SelectionChanged="ComboBoxProduct_SelectionChanged"
                              IsEditable="True"/>

                    <!-- Текущий остаток -->
                    <TextBlock Text="Текущий остаток"
                               Grid.Row="4" Grid.Column="0"
                               VerticalAlignment="Center" FontWeight="Medium"/>
                    <Border Grid.Row="4" Grid.Column="1"
                            Background="#F0F4F8" CornerRadius="6" Padding="10,6">
                        <TextBlock x:Name="CountTextBox"
                                   Text="Выберите расходник..."
                                   FontSize="14"/>
                    </Border>

                    <!-- Количество для пополнения -->
                    <TextBlock Text="Пополнить на"
                               Grid.Row="6" Grid.Column="0"
                               VerticalAlignment="Center" FontWeight="Medium"/>
                    <Grid Grid.Row="6" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="TextBoxCountProduct"
                                    PlaceholderText="Введите количество (л / шт)"
                                    Grid.Column="0"/>
                        <TextBlock Text="л/шт"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Foreground="Gray"/>
                    </Grid>

                    <!-- Кнопка -->
                    <ui:Button Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"
                               Content="Пополнить запас"
                               Icon="{ui:SymbolIcon ArrowDownload24}"
                               Appearance="Primary"
                               HorizontalAlignment="Left"
                               Click="Button_Click"/>
                </Grid>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>
</UserControl>
