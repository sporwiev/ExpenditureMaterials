<UserControl x:Class="BifServiceExpenditureMaterials.Views.Pages.SavePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="900"
             Loaded="UserControl_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <!-- Заголовок -->
            <TextBlock Text="Сохранение и загрузка"
                       FontSize="22" FontWeight="SemiBold"
                       Margin="0,0,0,16"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Левая карточка — локальные снимки -->
                <ui:Card Grid.Column="0" Padding="16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <ui:SymbolIcon Symbol="Save24" Margin="0,0,8,0" FontSize="18"/>
                            <TextBlock Text="Снимки базы данных"
                                       FontSize="16" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <ListBox x:Name="listfiles"
                                 MinHeight="200"
                                 BorderThickness="1"
                                 BorderBrush="#DDE3EA"
                                 Background="#F7F9FC"/>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:Button Grid.Column="0"
                                       Content="Сохранить"
                                       Icon="{ui:SymbolIcon Save24}"
                                       Appearance="Primary"
                                       HorizontalAlignment="Stretch"
                                       Click="Save_Click"/>
                            <ui:Button Grid.Column="2"
                                       Content="Загрузить"
                                       Icon="{ui:SymbolIcon FolderOpen24}"
                                       HorizontalAlignment="Stretch"
                                       Click="Download_Click"/>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- Правая карточка — отправить файл -->
                <ui:Card Grid.Column="2" Padding="16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <ui:SymbolIcon Symbol="Send24" Margin="0,0,8,0" FontSize="18"/>
                            <TextBlock Text="Отправить пользователю"
                                       FontSize="16" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="Принятые файлы" FontWeight="Medium" Margin="0,0,0,6"/>
                        <ListBox x:Name="responcePanel"
                                 MinHeight="80"
                                 BorderThickness="1"
                                 BorderBrush="#DDE3EA"
                                 Background="#F7F9FC"/>

                        <TextBlock Text="Отправить снимок" FontWeight="Medium" Margin="0,12,0,6"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="recipientComboBox"
                                      Grid.Column="0"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="Андрей"/>
                                <ComboBoxItem Content="Ольга"/>
                                <ComboBoxItem Content="Антон"/>
                            </ComboBox>
                            <ui:Button Grid.Column="2"
                                       Content="Отправить"
                                       Icon="{ui:SymbolIcon Send24}"
                                       Appearance="Primary"
                                       Click="Send_Click"/>
                        </Grid>
                    </StackPanel>
                </ui:Card>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
