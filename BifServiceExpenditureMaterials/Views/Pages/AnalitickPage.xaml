<UserControl x:Class="BifServiceExpenditureMaterials.Views.Pages.AnalitickPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:BifServiceExpenditureMaterials.Controls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="Аналитика расходников"
                   FontSize="22" FontWeight="SemiBold"
                   Grid.Row="0"/>

        <!-- Фильтры -->
        <ui:Card Grid.Row="2" Padding="16">
            <WrapPanel Orientation="Horizontal">

                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Год" FontWeight="Medium" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ComboBoxYear" Width="110"/>
                </StackPanel>

                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Месяц" FontWeight="Medium" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ComboBoxMonth" Width="130"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Тип расходника" FontWeight="Medium" Margin="0,0,0,4"/>
                    <ComboBox x:Name="TypeProductComboBox"
                              Width="160"
                              SelectionChanged="TypeProductComboBox_SelectionChanged">
                        <ComboBoxItem/>
                        <ComboBoxItem Content="🛢 Масло"/>
                        <ComboBoxItem Content="❄ Антифриз"/>
                        <ComboBoxItem Content="🔧 Смазка"/>
                        <ComboBoxItem Content="🔩 Фильтры"/>
                    </ComboBox>
                </StackPanel>

            </WrapPanel>
        </ui:Card>

        <!-- Статистика -->
        <Border Grid.Row="4"
                Background="#EDF7ED" CornerRadius="8" Padding="14,10">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="DataHistogram24"
                               FontSize="18" Margin="0,0,10,0"
                               Foreground="#2E7D32"/>
                <TextBlock x:Name="typeproduct"
                           Text="—"
                           FontSize="16" FontWeight="Medium"
                           VerticalAlignment="Center"
                           Foreground="#2E7D32"/>
                <TextBlock Text="  |  " Foreground="Gray" VerticalAlignment="Center"/>
                <TextBlock x:Name="sum"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Foreground="#555"/>
            </StackPanel>
        </Border>

        <!-- График -->
        <ScrollViewer Grid.Row="6" VerticalScrollBarVisibility="Auto">
            <controls:Charts x:Name="MyChart"/>
        </ScrollViewer>

    </Grid>
</UserControl>
